{
  "name": "hydraone-sdk-monorepo",
  "private": true,
  "description": "Monorepo for the HydraOne SDK (@hydraone/sdk) and its documentation site",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vtechcom/hydraone-sdk.git"
  },
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build": "pnpm --filter @hydraone/sdk build",
    "lint": "pnpm --filter @hydraone/sdk lint",
    "typecheck": "pnpm --filter @hydraone/sdk typecheck",
    "test": "pnpm --filter @hydraone/sdk test",
    "test:coverage": "pnpm --filter @hydraone/sdk test:coverage",
    "size": "pnpm --filter @hydraone/sdk size",
    "check:package": "pnpm --filter @hydraone/sdk check:package",
    "docs:api": "pnpm --filter @hydraone/sdk run docs",
    "dev:docs": "pnpm --filter @hydraone/docs dev",
    "build:docs": "pnpm --filter @hydraone/docs generate",
    "dev:next": "pnpm --filter @hydraone/template-next-js dev",
    "dev:nuxt": "pnpm --filter @hydraone/template-nuxt dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
