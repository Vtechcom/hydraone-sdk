{
  "name": "@hydraone/sdk",
  "version": "0.1.0",
  "description": "Official SDK for building HydraOne games and dApps on Cardano: wallet bridge, CIP-8 auth, React/Vue adapters and a local simulator",
  "keywords": [
    "cardano",
    "hydra",
    "hydraone",
    "web3",
    "sdk",
    "game-sdk",
    "cip-30",
    "cip-8",
    "wallet-bridge"
  ],
  "homepage": "https://github.com/Vtechcom/hydraone-sdk#readme",
  "bugs": {
    "url": "https://github.com/Vtechcom/hydraone-sdk/issues"
  },
  "license": "Apache-2.0",
  "author": "HydraOne Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vtechcom/hydraone-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cardano": {
      "import": {
        "types": "./dist/cardano/index.d.ts",
        "default": "./dist/cardano/index.js"
      },
      "require": {
        "types": "./dist/cardano/index.d.cts",
        "default": "./dist/cardano/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.js"
      },
      "require": {
        "types": "./dist/vue/index.d.cts",
        "default": "./dist/vue/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./simulator": {
      "import": {
        "types": "./dist/simulator/index.d.ts",
        "default": "./dist/simulator/index.js"
      },
      "require": {
        "types": "./dist/simulator/index.d.cts",
        "default": "./dist/simulator/index.cjs"
      }
    },
    "./diagnostics": {
      "import": {
        "types": "./dist/diagnostics/index.d.ts",
        "default": "./dist/diagnostics/index.js"
      },
      "require": {
        "types": "./dist/diagnostics/index.d.cts",
        "default": "./dist/diagnostics/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "create-hydraone-game": "./bin/create-hydraone-game.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "!templates/**/node_modules",
    "!templates/**/.next",
    "!templates/**/.nuxt",
    "!templates/**/.output",
    "!templates/**/dist",
    "!templates/**/next-env.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:next": "pnpm --filter @hydraone/template-next-js dev",
    "dev:nuxt": "pnpm --filter @hydraone/template-nuxt-3 dev",
    "dev:phaser": "pnpm --filter @hydraone/template-phaser-3 dev"
  },
  "peerDependencies": {
    "phaser": ">=3.60.0",
    "react": ">=18.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "vue": "^3.5.43"
  }
}
