{
  "name": "hydraone-sdk-monorepo",
  "private": true,
  "description": "Monorepo for the HydraOne SDK (@hydraone-sdk/core) and its documentation site",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vtechcom/hydraone-sdk.git"
  },
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build": "pnpm --filter @hydraone-sdk/core build && pnpm --filter @hydraone-sdk/host build",
    "lint": "pnpm -r --filter @hydraone-sdk/core --filter @hydraone-sdk/host lint",
    "typecheck": "pnpm -r --filter @hydraone-sdk/core --filter @hydraone-sdk/host typecheck",
    "test": "pnpm -r --filter @hydraone-sdk/core --filter @hydraone-sdk/host test",
    "test:coverage": "pnpm --filter @hydraone-sdk/core test:coverage",
    "size": "pnpm --filter @hydraone-sdk/core size",
    "check:package": "pnpm --filter @hydraone-sdk/core check:package",
    "docs:api": "pnpm --filter @hydraone-sdk/core run docs",
    "dev:docs": "pnpm --filter @hydraone-sdk/docs dev",
    "build:docs": "pnpm --filter @hydraone-sdk/docs generate",
    "dev:next": "pnpm --filter @hydraone-sdk/template-next-js dev",
    "dev:nuxt": "pnpm --filter @hydraone-sdk/template-nuxt dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
