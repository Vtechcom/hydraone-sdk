{
  "name": "@hydraone/sdk",
  "version": "0.1.0",
  "description": "Official Game & dApp Developer Toolkit for HydraOne on Cardano",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cardano": {
      "types": "./dist/cardano/index.d.ts",
      "import": "./dist/cardano/index.js",
      "require": "./dist/cardano/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vtechcom/hydraone-sdk.git"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cardano",
    "hydra",
    "hydraone",
    "web3",
    "sdk",
    "game-sdk",
    "cip-30",
    "cip-8",
    "wallet-bridge"
  ],
  "author": "HydraOne Team",
  "license": "MIT",
  "peerDependencies": {
    "phaser": ">=3.60.0",
    "react": ">=18.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "vue": "^3.5.43"
  }
}
